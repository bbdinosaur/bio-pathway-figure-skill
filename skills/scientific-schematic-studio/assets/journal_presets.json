  "relation_grammar": {
    "activates": {"line": "solid", "head": "filled_arrow", "meaning": "Activation / phosphorylation / upregulation"},
    "catalyzes": {"line": "solid", "head": "filled_arrow", "meaning": "Enzymatic catalysis / conversion"},
    "inhibits": {"line": "solid", "head": "tbar", "meaning": "Direct inhibition / repression / blockade"},
    "inhibits_dashed": {"line": "dashed", "head": "tbar", "meaning": "Indirect or putative inhibition"},
    "translocates": {"line": "dashed", "head": "open_arrow", "meaning": "Translocation / trafficking / nuclear entry"},
    "binds": {"line": "solid", "head": "double_arrow", "meaning": "Physical binding / complex formation"},
    "flows": {"line": "solid", "head": "filled_arrow", "meaning": "Experimental workflow / sequential step"},
    "assoc": {"line": "dotted", "head": "none", "meaning": "Statistical or structural association"}
  }
